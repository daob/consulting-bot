# Copy to deploy.env and fill in. deploy.env is git-ignored: it names your
# server and is nobody else's business.
#
# SSH_TARGET     what you would type after `ssh`
# REMOTE_PUBLIC  where public/ goes: the web-reachable folder
# REMOTE_PRIVATE where private/ goes: NOT web-reachable

SSH_TARGET     = user@ssh.example.com
REMOTE_PUBLIC  = /home/user/webroots/sites/webspace/httpdocs/yoursite/consult
REMOTE_PRIVATE = /home/user/webroots/sites/webspace/private/consult
